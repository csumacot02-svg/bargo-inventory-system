APP_NAME="SLSU BARGO Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# On Render set: APP_URL=https://bargo-inventory-system.onrender.com
# and APP_ENV=production (do not leave APP_URL as http://localhost)
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite
DB_CONNECTION=sqlite

# --- MySQL (Laragon / XAMPP / production) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bargo_inventory
# DB_USERNAME=root
# DB_PASSWORD=

# --- Aiven Cloud MySQL (capstone deployment) ---
# DB_CONNECTION=mysql
# DB_HOST=your-project.aivencloud.com
# DB_PORT=12345
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your-aiven-password
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem

# --- Render hosting ---
# Set APP_URL to your Render URL
# Add MySQL (Aiven) credentials as Render environment variables
# Build: composer install --no-dev && npm ci && npm run build && php artisan migrate --force
# Start: php artisan serve --host=0.0.0.0 --port=$PORT
# Or use a Render PHP/Laravel blueprint with `php artisan migrate --force` release command

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP: false. Production HTTPS: true
SESSION_SECURE_COOKIE=false

# Production checklist (do not use these values on this PC until you have HTTPS):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-campus-domain
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=info
# Host with PHP-FPM + nginx/Apache, not `php artisan serve`
# Run: php artisan config:cache && php artisan route:cache && php artisan view:cache
# Keep a queue worker: php artisan queue:work
# Schedule: php artisan schedule:work  (daily digest 07:30, backup 01:15)
# Nightly backup: php artisan bargo:backup  → storage/app/backups
# Restore drill: import the .sql (MySQL) or copy the .sqlite file before go-live

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bargo@slsu.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

# --- Production email ---
# Render Free BLOCKS outbound SMTP (ports 465/587), so Gmail SMTP will 500.
# Use Resend over HTTPS instead (https://resend.com) — free tier works on Render Free:
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM_ADDRESS=onboarding@resend.dev
# MAIL_FROM_NAME="SLSU BARGO Inventory"
# (After you verify a domain in Resend, change MAIL_FROM_ADDRESS to your domain.)
#
# Paid Render only — Gmail SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_FROM_ADDRESS=your-gmail@gmail.com
# MAIL_FROM_NAME="SLSU BARGO Inventory"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CACHE_MINUTES=60

# --- Google OAuth (Laravel Socialite) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Facebook OAuth (Laravel Socialite) ---
# Create an app at https://developers.facebook.com/apps/
# Valid OAuth Redirect URI must match FACEBOOK_REDIRECT_URI exactly.
# Request the email permission for registration.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

VITE_APP_NAME="${APP_NAME}"
